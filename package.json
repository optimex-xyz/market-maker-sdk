{
  "name": "@optimex-xyz/market-maker-sdk",
  "version": "0.11.2",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/optimex-xyz/market-maker-sdk.git"
  },
  "homepage": "https://github.com/optimex-xyz/market-maker-sdk#readme",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "maker",
    "market",
    "sdk"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "prepare": "simple-git-hooks",
    "lint": "eslint --ext .js,.ts,.tsx src/",
    "format": "prettier --write \"src/**/*.{js,ts,tsx}\"",
    "lint-staged": "lint-staged",
    "ctix": "node generate-indexes.js",
    "generate:abi": "rm -rf src/abi && rm -rf src/types/contract && node scripts/generate-abi.js",
    "commit": "git-cz"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bip174": "^3.0.0",
    "bitcoinjs-lib": "^7.0.1",
    "ecpair": "^3.0.0",
    "tiny-secp256k1": "^2.2.4",
    "viem": "^2.44.4",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@eslint/js": "^9.39.2",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@types/node": "^25.0.9",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "commitizen": "^4.3.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.3.0",
    "git-cz": "^4.9.0",
    "globals": "^17.0.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.0",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.20.0-beta.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "npx commitlint --edit $1"
  },
  "lint-staged": {
    "src/**/*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
